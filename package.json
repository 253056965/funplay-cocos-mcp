{
  "name": "funplay-cocos-mcp",
  "title": "Funplay Cocos MCP",
  "version": "0.1.0",
  "description": "Embedded MCP server for Cocos Creator 2.4.x with scene script execution, scene/node/component tools, selection, screenshots, and editor automation.",
  "author": "Funplay",
  "license": "MIT",
  "main": "main.js",
  "scene-script": "scene.js",
  "main-menu": {
    "Funplay Cocos MCP/Open Panel": {
      "message": "funplay-cocos-mcp:open-panel"
    },
    "Funplay Cocos MCP/Start Server": {
      "message": "funplay-cocos-mcp:start-server"
    },
    "Funplay Cocos MCP/Stop Server": {
      "message": "funplay-cocos-mcp:stop-server"
    },
    "Funplay Cocos MCP/Restart Server": {
      "message": "funplay-cocos-mcp:restart-server"
    }
  },
  "panel": {
    "main": "panel/index.js",
    "type": "dockable",
    "title": "Funplay Cocos MCP",
    "width": 560,
    "height": 620,
    "min-width": 420,
    "min-height": 360,
    "resizable": true,
    "devTools": false,
    "save": false,
    "engineSupport": false
  },
  "profiles": {
    "local": {
      "port": 8765,
      "autostart": true,
      "enableConsoleLogging": true,
      "language": "auto"
    }
  }
}
